# ── infra (docker-compose 가 읽는 값) ─────────────────────────────
POSTGRES_USER=jobstack
POSTGRES_PASSWORD=jobstack
POSTGRES_DB=jobstack
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── db ────────────────────────────────────────────────────────────
# 개발: 단일 유저(소유자)로 접속
DATABASE_URL=postgresql+psycopg://jobstack:jobstack@localhost:5432/jobstack
# 운영: 크롤러/챗봇 분리 (init.sql 의 ai_crawler / ai_chat 롤)
# DATABASE_URL=postgresql+psycopg://ai_crawler:...@db:5432/jobstack
# CHAT_DATABASE_URL=postgresql+psycopg://ai_chat:...@db:5432/jobstack
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── worker (arq) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=600

# ── auth ──────────────────────────────────────────────────────────
# dev: X-User-Id 헤더를 그대로 신뢰 / jwt: RS256 공개키 검증
AUTH_MODE=dev
DEV_USER_ID=dev-user-1
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
# PEM 본문 또는 파일 경로 (메인 백엔드와 전달 방법 합의 필요)
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWKS_URL=

# ── cors ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── llm (chat) ────────────────────────────────────────────────────
# ★ GOOGLE_API_KEY 는 챗봇(gemini)과 임베딩이 함께 쓰는 하나의 키다.
#   따로 발급하지 않는다.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
USE_FAKE_LLM=false

# ── embedding ─────────────────────────────────────────────────────
# EMBED_DIM 은 init.sql 의 vector(1024) 와 반드시 일치해야 한다.
#
# EMBED_PROVIDER  auto | gemini | fake
#   auto    키가 있으면 gemini, 없으면 fake (기본값)
#   gemini  임베딩 API. 키는 GOOGLE_API_KEY 공용
#   fake    해시 기반 더미 벡터 (키 불필요)
#
# ★ 모델을 바꾸면 기존 벡터는 못 쓴다. 차원만 1024 로 맞으면 INSERT 는 통과하고
#   코사인 유사도만 조용히 깨진다. 바꿨으면 전량 재임베딩할 것:
#       UPDATE market.job_posting SET embed_hash = NULL;
#       UPDATE market.company SET embed_hash = NULL, profile_embedding = NULL;
#       DELETE FROM market.posting_chunk;   -- 이게 빠지면 재임베딩이 안 일어난다
#       python -m app.cli embed && python -m app.cli embed --companies
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=1024
# gemini 의 batchEmbedContents 상한은 100 이다 (101 은 400). 96 은 그 아래다.
EMBED_BATCH_SIZE=96
# 1 = 어댑터 안에서 재시도하지 않는다. 실패분은 05:30 백필이 주워 간다.
# 429 가 일일 할당량 소진이면 65초 대기가 순수 낭비라 그렇게 뒀다.
EMBED_MAX_RETRY=1
EMBED_BACKFILL_LIMIT=500
EMBED_ENQUEUE_CHUNK=0
# 계정 레이트리밋 (0 = 제한 없음). 429 가 보이기 시작하면 실측값을 넣는다.
EMBED_RPM=0
EMBED_TPM=0

# ── chat guard ────────────────────────────────────────────────────
CHAT_RECURSION_LIMIT=8
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_DAILY_TOKEN_BUDGET=200000
CHAT_HISTORY_TOKEN_BUDGET=12000

# ── crawler ───────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_DELAY_SECONDS=20.0
CRAWL_DELAY_FACTOR=1.6
CRAWL_MAX_RETRY=3
CRAWL_SNAPSHOT_DIR=./var/snapshots
CRAWL_USER_AGENT=jobstack-bot/0.1
CRAWL_KEYWORDS=백엔드,프론트엔드,안드로이드,iOS,데이터,DevOps,AI
