# ── infra (docker-compose 가 읽는 값) ─────────────────────────────
POSTGRES_USER=jobstack
POSTGRES_PASSWORD=jobstack
POSTGRES_DB=jobstack
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── db ────────────────────────────────────────────────────────────
# 개발: 단일 유저(소유자)로 접속
DATABASE_URL=postgresql+psycopg://jobstack:jobstack@localhost:5432/jobstack
# 운영: 크롤러/챗봇 분리 (init.sql 의 ai_crawler / ai_chat 롤)
# DATABASE_URL=postgresql+psycopg://ai_crawler:...@db:5432/jobstack
# CHAT_DATABASE_URL=postgresql+psycopg://ai_chat:...@db:5432/jobstack
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── worker (arq) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=600

# ── auth ──────────────────────────────────────────────────────────
# dev: X-User-Id 헤더를 그대로 신뢰 / jwt: RS256 공개키 검증
AUTH_MODE=dev
DEV_USER_ID=dev-user-1
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
# PEM 본문 또는 파일 경로 (메인 백엔드와 전달 방법 합의 필요)
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWKS_URL=

# ── cors ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── llm (chat) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
USE_FAKE_LLM=false

# ── embedding ─────────────────────────────────────────────────────
# EMBED_DIM 은 init.sql 의 vector(1024) 와 반드시 일치해야 한다.
#
# EMBED_PROVIDER  auto | local | voyage | fake
#   auto    키가 있으면 voyage, 없으면 fake (기본값)
#   local   BGE-m3 로컬. `uv sync --group local` 필요
#   voyage  임베딩 API
#   fake    해시 기반 더미 벡터 (키 불필요)
#
# ★ local 과 voyage 의 벡터는 호환되지 않는다. 차원이 둘 다 1024 라 INSERT 는
#   통과하는데 코사인 유사도만 조용히 깨진다. 바꿨으면 전량 재임베딩할 것:
#       python -m app.cli embed
EMBED_PROVIDER=auto
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3-large
EMBED_DIM=1024
EMBED_BATCH_SIZE=96
EMBED_MAX_RETRY=3
# 무료 등급 기준값. 표준 등급이면 500 / 0 으로 되돌린다.
EMBED_BACKFILL_LIMIT=100
EMBED_ENQUEUE_CHUNK=40
# 계정 레이트리밋 (0 = 제한 없음). 무료 등급이면 EMBED_RPM=3 / EMBED_TPM=10000.
EMBED_RPM=0
EMBED_TPM=0

# ── embedding: local (EMBED_PROVIDER=local 일 때만) ────────────────
# 레이트리밋(EMBED_RPM/TPM)과 EMBED_BATCH_SIZE 는 여기에 적용되지 않는다.
EMBED_LOCAL_MODEL=BAAI/bge-m3
# 빈 값이면 자동 감지 (cuda → mps → cpu)
EMBED_LOCAL_DEVICE=
# M5 Pro 실측 — 32: 92.0청크/초 · 64: 78.6 · 96: 63.4
EMBED_LOCAL_BATCH_SIZE=32
# GPU 에서만 적용. fp32 대비 3.1배, 코사인 최소 0.99976 으로 품질 차이 없음
EMBED_LOCAL_FP16=true

# ── chat guard ────────────────────────────────────────────────────
CHAT_RECURSION_LIMIT=8
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_DAILY_TOKEN_BUDGET=200000
CHAT_HISTORY_TOKEN_BUDGET=12000

# ── crawler ───────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_DELAY_SECONDS=20.0
CRAWL_DELAY_FACTOR=1.6
CRAWL_MAX_RETRY=3
CRAWL_SNAPSHOT_DIR=./var/snapshots
CRAWL_USER_AGENT=jobstack-bot/0.1
CRAWL_KEYWORDS=백엔드,프론트엔드,안드로이드,iOS,데이터,DevOps,AI
