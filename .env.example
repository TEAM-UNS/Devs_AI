# ── db ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://jobstack:jobstack@localhost:5440/jobstack
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── worker (arq) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6390/0
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=600

# ── llm · embedding ───────────────────────────────────────────────
GOOGLE_API_KEY=
EMBED_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
EMBED_OLLAMA_MODEL=bge-m3
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_MODEL=gemini-3.8-flash

EMBED_DIM=1024
EMBED_BATCH_SIZE=96
EMBED_MAX_RETRY=1
EMBED_BACKFILL_LIMIT=500
EMBED_RPM=0
EMBED_TPM=0

# ── crawler ───────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_DELAY_SECONDS=20.0
CRAWL_DELAY_FACTOR=1.6
CRAWL_MAX_RETRY=3
CRAWL_USER_AGENT=jobstack-bot/0.1

