# ── infra (docker-compose 가 읽는 값) ─────────────────────────────
POSTGRES_USER=jobstack
POSTGRES_PASSWORD=jobstack
POSTGRES_DB=jobstack
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── db ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://jobstack:jobstack@localhost:5432/jobstack
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── worker (arq) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=600

# ── cors ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── llm · embedding ───────────────────────────────────────────────
# GOOGLE_API_KEY 는 챗봇(gemini)과 임베딩이 함께 쓰는 하나의 키다.
GOOGLE_API_KEY=
# auto | gemini | fake  (auto = 키가 있으면 gemini)
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-2
# ★ init.sql 의 vector(1024) 와 반드시 일치. 바꾸면 전량 재임베딩해야 한다.
EMBED_DIM=1024
# gemini 의 batchEmbedContents 상한은 100 이다 (101 은 400).
EMBED_BATCH_SIZE=96
# 1 = 어댑터 안에서 재시도하지 않는다. 실패분은 백필이 주워 간다.
EMBED_MAX_RETRY=1
EMBED_BACKFILL_LIMIT=500
# 계정 레이트리밋 (0 = 제한 없음)
EMBED_RPM=0
EMBED_TPM=0

# ── crawler ───────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_DELAY_SECONDS=20.0
CRAWL_DELAY_FACTOR=1.6
CRAWL_MAX_RETRY=3
CRAWL_USER_AGENT=jobstack-bot/0.1

