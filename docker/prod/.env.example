# 배포용 환경변수. 서버의 docker/prod/.env 로 복사해서 채운다. 호스트는 전부 컨테이너 기준

IMAGE_TAG=latest

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db:5432/devs
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

REDIS_URL=redis://ai-redis:6379/0
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=600

CORS_ORIGINS=

GOOGLE_API_KEY=
TYPESAFE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# DB 벡터가 bge-m3 라 ollama 고정. gemini 와 섞으면 코사인이 깨진다
EMBED_PROVIDER=ollama
OLLAMA_HOST=http://ai-ollama:11434
EMBED_OLLAMA_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=96
EMBED_MAX_RETRY=1
EMBED_BACKFILL_LIMIT=500
EMBED_RPM=0
EMBED_TPM=0

CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_DELAY_SECONDS=20.0
CRAWL_DELAY_FACTOR=1.6
CRAWL_MAX_RETRY=3
CRAWL_USER_AGENT=jobstack-bot/0.1

CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_DAILY_TOKEN_BUDGET=200000
